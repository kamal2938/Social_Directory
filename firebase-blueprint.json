          "entityType": "string",
          "entityId": "string",
          "action": "string",
          "details": "string",
          "createdAt": "string"
        },
        "rules": [
          {
            "allow": ["read"],
            "condition": "request.auth != null && request.auth.uid == resource.data.userId"
          },
          {
            "allow": ["create"],
            "condition": "request.auth != null && request.auth.uid == request.resource.data.userId"
          }
        ]
      },
      "settings": {
        "description": "User specific app settings",
        "document_id": "userId",
        "fields": {
          "appTitle": "string",
          "ownerName": "string"
        },
        "rules": [
          {
            "allow": ["read", "write"],
            "condition": "request.auth != null && request.auth.uid == document_id"
          }
        ]
      }
    }
  }
}
